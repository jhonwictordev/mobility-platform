{
  "expo": {
    "name": "SIMBORA Passageiro",
    "slug": "simbora-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simbora.passenger",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para encontrar motoristas parceiros próximos.",
        "NSLocationAlwaysUsageDescription": "Precisamos da sua localização para acompanhar sua viagem com segurança."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123D32"
      },
      "package": "com.simbora.passenger",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-location"
    ]
  }
}
