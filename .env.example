# =====================================================================
# SIMBORA MOBILITY PLATFORM — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# =====================================================================

# ---------------------------------------------------------------------
# 1. MAPTILER CLOUD (Renderização Vetorial e Raster de Mapas)
# Obtenha sua chave gratuita em: https://cloud.maptiler.com/account/keys/
# Limite gratuito: 100.000 requisições/mês (sem custo)
# ---------------------------------------------------------------------
VITE_MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# ---------------------------------------------------------------------
# 2. OPENROUTESERVICE (Cálculo de Rotas Rodoviárias no Backend)
# Obtenha sua chave gratuita em: https://openrouteservice.org/dev/#/signup
# Limite gratuito: 2.000 requisições de direção/dia (sem custo)
# A chave privada é mantida ESTRITAMENTE no backend e nunca exposta na web.
# ---------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=

# ---------------------------------------------------------------------
# 3. BACKEND NESTJS & WEBSOCKET
# ---------------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_secure_random_jwt_secret_minimum_32_characters
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------
# 4. PAINEL ADMINISTRATIVO (Next.js)
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
